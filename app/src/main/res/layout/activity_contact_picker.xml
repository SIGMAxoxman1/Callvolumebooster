<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:text="Choose VIP contacts"
        android:textColor="@color/paper"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/search_bg"
        android:hint="Search contacts"
        android:textColorHint="@color/paper_dim"
        android:textColor="@color/paper"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text"
        android:singleLine="true"
        android:imeOptions="actionSearch" />

    <TextView
        android:id="@+id/emptyContactsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="No contacts found on this device."
        android:textColor="@color/paper_dim"
        android:visibility="gone" />

    <ListView
        android:id="@+id/contactsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/line"
        android:dividerHeight="1dp" />

</LinearLayout>
EOF

cat > res/drawable/search_bg.xml << 'EOF'
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#1C1F25" />
    <corners android:radius="10dp" />
    <stroke android:width="1dp" android:color="#2B2F37" />
</shape>

