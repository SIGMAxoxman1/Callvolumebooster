<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="&#931; Sigma Apps"
        android:textColor="@color/signal"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Call Volume Booster"
        android:textColor="@color/paper"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="36dp"
        android:text="No VIP contact selected yet."
        android:textColor="@color/paper_dim"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pickContactButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/signal"
        android:text="Choose VIP contact"
        android:textColor="@color/ink"
        android:textAllCaps="false"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/grantPermissionsButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:text="Grant permissions"
        android:textColor="@color/paper"
        app:strokeColor="@color/line"
        android:textAllCaps="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/startServiceButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:text="Start watching for calls"
        android:textColor="@color/paper"
        app:strokeColor="@color/line"
        android:textAllCaps="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Everyone else on your phone keeps ringing normally. Only your chosen contact gets the extra-loud ring."
        android:textColor="@color/paper_dim"
        android:textSize="13sp" />

</LinearLayout>
